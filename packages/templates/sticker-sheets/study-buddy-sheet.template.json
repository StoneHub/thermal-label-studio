{
  "schemaVersion": "tls.template/v1",
  "id": "study-buddy-sheet",
  "name": "Study Buddy Sticker Sheet",
  "mode": "sticker_sheet_2x3",
  "canvas": {
    "width": 800,
    "height": 1200,
    "dpi": 203,
    "unit": "px"
  },
  "theme": {
    "tags": [
      "cute",
      "school",
      "planner"
    ],
    "defaultPalette": {
      "bg": "#f7faff",
      "fg": "#2f2235",
      "accent": "#6f8bff"
    }
  },
  "fields": {
    "sheet_title": {
      "type": "text",
      "label": "Sheet header",
      "default": "Study Buddy Set",
      "maxLength": 40
    },
    "sheet_icon": {
      "type": "image",
      "label": "Optional sheet icon",
      "required": false,
      "fit": "cover"
    },
    "sticker1_title": {
      "type": "text",
      "label": "Sticker 1 title",
      "default": "Focus",
      "maxLength": 24
    },
    "sticker1_subtitle": {
      "type": "text",
      "label": "Sticker 1 subtitle",
      "default": "deep work time",
      "maxLength": 42
    },
    "sticker1_icon": {
      "type": "image",
      "label": "Sticker 1 icon",
      "required": false,
      "fit": "contain"
    },
    "sticker2_title": {
      "type": "text",
      "label": "Sticker 2 title",
      "default": "Break",
      "maxLength": 24
    },
    "sticker2_subtitle": {
      "type": "text",
      "label": "Sticker 2 subtitle",
      "default": "stretch + water",
      "maxLength": 42
    },
    "sticker2_icon": {
      "type": "image",
      "label": "Sticker 2 icon",
      "required": false,
      "fit": "contain"
    },
    "sticker3_title": {
      "type": "text",
      "label": "Sticker 3 title",
      "default": "Read",
      "maxLength": 24
    },
    "sticker3_subtitle": {
      "type": "text",
      "label": "Sticker 3 subtitle",
      "default": "chapter check",
      "maxLength": 42
    },
    "sticker3_icon": {
      "type": "image",
      "label": "Sticker 3 icon",
      "required": false,
      "fit": "contain"
    },
    "sticker4_title": {
      "type": "text",
      "label": "Sticker 4 title",
      "default": "Plan",
      "maxLength": 24
    },
    "sticker4_subtitle": {
      "type": "text",
      "label": "Sticker 4 subtitle",
      "default": "tiny next step",
      "maxLength": 42
    },
    "sticker4_icon": {
      "type": "image",
      "label": "Sticker 4 icon",
      "required": false,
      "fit": "contain"
    },
    "sticker5_title": {
      "type": "text",
      "label": "Sticker 5 title",
      "default": "Quiz",
      "maxLength": 24
    },
    "sticker5_subtitle": {
      "type": "text",
      "label": "Sticker 5 subtitle",
      "default": "practice round",
      "maxLength": 42
    },
    "sticker5_icon": {
      "type": "image",
      "label": "Sticker 5 icon",
      "required": false,
      "fit": "contain"
    },
    "sticker6_title": {
      "type": "text",
      "label": "Sticker 6 title",
      "default": "A+ Mode",
      "maxLength": 24
    },
    "sticker6_subtitle": {
      "type": "text",
      "label": "Sticker 6 subtitle",
